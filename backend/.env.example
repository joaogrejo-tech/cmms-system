# Banco de dados
DATABASE_URL="postgresql://cmms_user:cmms_password@localhost:5432/cmms_db?schema=public"

# Servidor
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=troque-este-valor-em-producao-por-uma-string-aleatoria-forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-valor-tambem-em-producao
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
