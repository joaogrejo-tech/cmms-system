// ============================================================================
// CMMS - Sistema de Gestão da Manutenção Industrial
// Schema Prisma - PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  PCM
  MECANICO
  ELETRICISTA
  SUPERVISOR
  SOLICITANTE
}

enum WorkOrderStatus {
  ABERTA
  EM_ANALISE
  AGUARDANDO_PECA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum WorkOrderSubStatus {
  AGUARDANDO_APROVACAO
  AGUARDANDO_TECNICO
  AGUARDANDO_MATERIAL
  AGUARDANDO_PARADA
  EM_EXECUCAO
  AGUARDANDO_TESTE
  FINALIZADA
  REPROVADA
}

enum MaintenanceType {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
  MELHORIA
  INSPECAO
  LUBRIFICACAO
  CALIBRACAO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum Specialty {
  ELETRICA
  MECANICA
  ELETROMECANICA
  PCM
  TERCEIRIZADO
  SOLDA_CALDEIRARIA
  CIVIL
  INSTRUMENTACAO
  AUTOMACAO
  UTILIDADES
  REFRIGERACAO
  ENVASE
  QUALIDADE
  OUTROS
}

enum AssetCriticality {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum AssetStatus {
  OPERACIONAL
  EM_MANUTENCAO
  PARADO
  DESATIVADO
  RESERVA
}

enum PurchaseStatus {
  SOLICITACAO
  EM_COTACAO
  PEDIDO_EMITIDO
  MATERIAL_RECEBIDO
  CANCELADO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  DEVOLUCAO
}

enum NotificationType {
  OS_ATRASADA
  PREVENTIVA_VENCIDA
  COMPRA_PENDENTE
  ESTOQUE_BAIXO
  MATERIAL_RECEBIDO
  OS_ATRIBUIDA
  COMENTARIO_OS
}

enum FrequencyUnit {
  DIAS
  SEMANAS
  MESES
  ANOS
  HORAS_USO
}

// ============================================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(SOLICITANTE)
  specialty     Specialty?
  sectorId      String?
  sector        Sector?   @relation(fields: [sectorId], references: [id])
  avatarUrl     String?
  phone         String?
  registration  String?   @unique // matrícula
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  workOrdersRequested WorkOrder[]      @relation("Requester")
  workOrdersAssigned  WorkOrder[]      @relation("AssignedTo")
  comments            Comment[]
  attachments         Attachment[]
  notifications       Notification[]
  workOrderHistory    WorkOrderHistory[]
  laborEntries        LaborEntry[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([sectorId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE_OS, UPDATE_ASSET, DELETE_USER etc
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================================================
// ORGANIZAÇÃO (Setores)
// ============================================================================

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  costCenter  String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  assets      Asset[]
  workOrders  WorkOrder[]

  @@map("sectors")
}

// ============================================================================
// ATIVOS
// ============================================================================

model Asset {
  id             String           @id @default(uuid())
  code           String           @unique
  tag            String           @unique
  name           String
  model          String?
  manufacturer   String?
  serialNumber   String?
  manufactureYear Int?
  costCenter     String?
  sectorId       String
  sector         Sector           @relation(fields: [sectorId], references: [id])
  criticality    AssetCriticality @default(MEDIA)
  location       String?
  parentAssetId  String?
  parentAsset    Asset?           @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets    Asset[]          @relation("AssetHierarchy")
  manualUrl      String?
  imageUrl       String?
  status         AssetStatus      @default(OPERACIONAL)
  acquisitionValue Decimal?       @db.Decimal(12, 2)
  installDate    DateTime?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workOrders          WorkOrder[]
  preventivePlans      PreventivePlan[]
  attachments          Attachment[]
  meterReadings        AssetMeterReading[]

  @@index([sectorId])
  @@index([status])
  @@map("assets")
}

model AssetMeterReading {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  value     Decimal  @db.Decimal(12, 2) // horas de uso, km, ciclos etc
  unit      String   @default("horas")
  readAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([assetId])
  @@map("asset_meter_readings")
}

// ============================================================================
// ORDENS DE SERVIÇO
// ============================================================================

model WorkOrder {
  id             Int                 @id @default(autoincrement())
  code           String              @unique // ex: OS-2026-000123
  description    String
  detailedNotes  String?
  specialty      Specialty
  sectorId       String
  sector         Sector              @relation(fields: [sectorId], references: [id])
  maintenanceType MaintenanceType
  priority       Priority            @default(MEDIA)
  requesterId    String
  requester      User                @relation("Requester", fields: [requesterId], references: [id])
  assignedToId   String?
  assignedTo     User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  assetId        String?
  asset          Asset?              @relation(fields: [assetId], references: [id])
  status         WorkOrderStatus     @default(ABERTA)
  subStatus      WorkOrderSubStatus?
  openedAt       DateTime            @default(now())
  dueAt          DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  slaHours       Int?                // meta de SLA em horas conforme prioridade
  totalCost      Decimal             @default(0) @db.Decimal(12, 2)
  preventivePlanId String?
  preventivePlan   PreventivePlan?   @relation(fields: [preventivePlanId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  history        WorkOrderHistory[]
  comments       Comment[]
  attachments    Attachment[]
  partsUsed      WorkOrderPart[]
  laborEntries   LaborEntry[]
  checklistItems ChecklistItem[]

  @@index([status])
  @@index([sectorId])
  @@index([specialty])
  @@index([priority])
  @@index([assignedToId])
  @@index([openedAt])
  @@map("work_orders")
}

model WorkOrderHistory {
  id          String    @id @default(uuid())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_history")
}

model Comment {
  id          String    @id @default(uuid())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  content     String
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@map("comments")
}

model Attachment {
  id          String     @id @default(uuid())
  fileName    String
  fileUrl     String
  fileType    String     // image/pdf/doc
  fileSize    Int
  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy  User       @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([workOrderId])
  @@index([assetId])
  @@map("attachments")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  description String
  done        Boolean   @default(false)
  order       Int       @default(0)

  @@index([workOrderId])
  @@map("checklist_items")
}

model LaborEntry {
  id          String    @id @default(uuid())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  hours       Decimal   @db.Decimal(6, 2)
  hourlyRate  Decimal?  @db.Decimal(10, 2)
  date        DateTime  @default(now())
  notes       String?

  @@index([workOrderId])
  @@map("labor_entries")
}

model WorkOrderPart {
  id           String     @id @default(uuid())
  workOrderId  Int
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId       String
  part         Part       @relation(fields: [partId], references: [id])
  quantity     Decimal    @db.Decimal(10, 2)
  unitCost     Decimal    @db.Decimal(10, 2)

  @@index([workOrderId])
  @@index([partId])
  @@map("work_order_parts")
}

// ============================================================================
// PREVENTIVAS
// ============================================================================

model PreventivePlan {
  id              String        @id @default(uuid())
  name            String
  assetId         String
  asset           Asset         @relation(fields: [assetId], references: [id])
  specialty       Specialty
  frequencyValue  Int
  frequencyUnit   FrequencyUnit
  estimatedHours  Decimal?      @db.Decimal(6, 2)
  checklistTemplate Json?       // array de strings de tarefas padrão
  instructions    String?
  lastGeneratedAt DateTime?
  nextDueAt       DateTime
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workOrders      WorkOrder[]

  @@index([assetId])
  @@index([nextDueAt])
  @@map("preventive_plans")
}

// ============================================================================
// FORNECEDORES
// ============================================================================

model Supplier {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?  @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  rating    Decimal? @db.Decimal(2, 1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases PurchaseOrder[]
  parts     Part[]

  @@map("suppliers")
}

// ============================================================================
// COMPRAS
// ============================================================================

model PurchaseOrder {
  id           String         @id @default(uuid())
  code         String         @unique
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  status       PurchaseStatus @default(SOLICITACAO)
  requestedById String
  totalValue   Decimal        @default(0) @db.Decimal(12, 2)
  requestedAt  DateTime       @default(now())
  quotationDeadline DateTime?
  expectedAt   DateTime?
  receivedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items        PurchaseOrderItem[]

  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partId          String?
  part            Part?         @relation(fields: [partId], references: [id])
  description     String
  quantity        Decimal       @db.Decimal(10, 2)
  unitValue       Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ============================================================================
// ESTOQUE
// ============================================================================

model Part {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  unit         String   @default("UN")
  quantity     Decimal  @default(0) @db.Decimal(12, 2)
  minStock     Decimal  @default(0) @db.Decimal(12, 2)
  location     String?
  unitCost     Decimal  @default(0) @db.Decimal(10, 2)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements       StockMovement[]
  workOrderParts  WorkOrderPart[]
  purchaseItems   PurchaseOrderItem[]

  @@index([quantity])
  @@map("parts")
}

model StockMovement {
  id        String            @id @default(uuid())
  partId    String
  part      Part              @relation(fields: [partId], references: [id])
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 2)
  reason    String?
  createdById String
  createdAt DateTime          @default(now())

  @@index([partId])
  @@map("stock_movements")
}

// ============================================================================
// NOTIFICAÇÕES
// ============================================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  entityId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}
